        "C": {
          "label": "{'DBL?' if _pend == 'C' else AM[am - 1]}",
          "color": "AMC[am - 1]",
          "short": [
            {
              "inc": "am",
              "by": 1,
              "mod": 3,
              "lo": 1
            },
            {
              "cc": 85,
              "val": "am"
            },
            {
              "flash": "MODE {AM[am - 1]}"
            }
          ],
          "double": [
            {
              "mode": "next"
            }
          ],
          "long": [
            {
              "set": "lp",
              "to": 1
            },
            {
              "cc": 110
            }
          ],
          "desc": {
            "short": {
              "en": "Cycle the Anagram mode Preset→Stomp→Scene (CC85). Runs after 0.5 s because it waits for a double click",
              "zh": "循环切换 Anagram 模式 Preset→Stomp→Scene（CC85）。因等待双击，0.5 秒后执行",
              "ja": "Anagram のモードを Preset→Stomp→Scene の順に切り替え（CC85）。ダブルクリックを待つため 0.5 秒後に実行",
              "ko": "Anagram 모드 순환 Preset→Stomp→Scene (CC85). 더블클릭을 기다려서 0.5초 뒤 실행"
            },
            "double": {
              "en": "Switch to the next controller mode (QC) and restart",
              "zh": "切换到下一个控制器模式（QC）并重启",
              "ja": "次のコントローラーモード（QC）に切り替えて再起動",
              "ko": "다음 컨트롤러 모드(QC)로 전환하고 재시작"
