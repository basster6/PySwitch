{
  "schema": 1,
  "name": "Anagram",
  "tag": "ANA",
  "channel": 1,
  "holdMs": 600,
  "doubleMs": 500,
  "power": true,
  "state": {
    "lp": 0,
    "am": 1,
    "fa": 0,
    "fb": 0,
    "fc": 0,
    "tun": 0,
    "pw": "USB",
    "pws": -1
  },
  "consts": {
    "AM": [
      "PRE",
      "STM",
      "SCN"
    ],
    "AMC": [
      "ORANGE",
      "GREEN",
      "TURQUOISE"
    ]
  },
  "vars": [],
  "screen": {
    "status": "ANA  {'LOOPER' if lp else 'PLAY'}",
    "statusColor": "'DARK_PURPLE' if lp else 'DARK_GREEN'",
    "power": "{('%d%%' % pwp) if pwp >= 0 else ('BAT' if pws == 1 else 'USB')}",
    "tiles": [
      {
        "caption": "MODE",
        "value": "{AM[am - 1]}",
        "color": "AMC[am - 1]"
      },
      {
        "caption": "FOOT",
        "value": "{('A' if fa else '-') + ('B' if fb else '-') + ('C' if fc else '-')}",
        "color": "'GREEN' if fa or fb or fc else 'DARK_GREEN'"
      },
      {
        "caption": "LOOPER",
        "value": "{'ON' if lp else 'OFF'}",
        "color": "'PURPLE' if lp else 'DARK_GRAY'"
      }
    ],
    "message": "",
    "messageColor": "BLACK"
  },
  "layers": [
    {
      "name": "Tuner",
      "when": "tun",
      "desc": {
        "en": "While the tuner is on: everything turns red. Hold 3 to close it.",
        "zh": "调音器打开时：屏幕全部变为红色。长按 3 号键关闭。",
        "ja": "チューナーがオンのとき：画面全体が赤くなります。3 を長押しで閉じます。",
        "ko": "튜너가 켜져 있을 때: 화면 전체가 빨간색이 돼요. 3을 길게 눌러 닫으세요."
      },
      "screen": {
        "status": "ANA  TUNER",
        "statusColor": "RED",
        "message": "TUNER ON (HOLD 3)",
        "messageColor": "RED",
        "tiles": [
          {
            "color": "RED"
          },
          {
            "color": "RED"
          },
          {
            "color": "RED"
          }
        ]
      },
      "keys": {}
    },
    {
      "name": "Looper",
      "when": "lp",
      "keys": {
        "1": {
          "label": "REC",
          "color": "RED",
          "short": [
            {
              "cc": 112
            },
            {
              "flash": "REC/DUB"
            }
          ],
          "long": [
            {
              "cc": 113
            },
            {
              "flash": "CLEAR"
            }
          ],
          "desc": {
            "short": {
              "en": "Record / overdub (CC112)",
              "zh": "录音/叠录（CC112）",
              "ja": "録音/オーバーダブ（CC112）",
              "ko": "녹음/오버더빙 (CC112)"
