            "long": {
              "en": "Clear the current slot (CC113)",
              "zh": "清除当前槽位（CC113）",
              "ja": "現在のスロットを消去（CC113）",
              "ko": "현재 슬롯 지우기 (CC113)"
            }
          },
          "hint": "CLEAR"
        },
        "2": {
          "label": "PLAY",
          "color": "GREEN",
          "short": [
            {
              "cc": 111
            },
            {
              "flash": "PLAY/STOP"
            }
          ],
          "desc": {
            "short": {
              "en": "Play / stop (CC111)",
              "zh": "播放/停止（CC111）",
              "ja": "再生/停止（CC111）",
              "ko": "재생/정지 (CC111)"
