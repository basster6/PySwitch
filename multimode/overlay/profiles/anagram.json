      "desc": {
        "en": "While the looper screen is open. Leave it with C.",
        "zh": "Looper 画面打开时。按 C 退出。",
        "ja": "ルーパー画面のとき。C で抜けます。",
        "ko": "루퍼 화면일 때. C로 빠져나와요."
      }
    },
    {
      "name": "Play",
      "when": "not lp",
      "keys": {
        "1": {
          "label": "FA{'+' if fa else '-'}",
          "color": "'GREEN' if fa else 'DARK_GREEN'",
          "short": [
            {
              "toggle": "fa"
            },
            {
              "cc": 17,
              "val": "127 if fa else 0"
            },
            {
              "flash": "FOOT A {'ON' if fa else 'OFF'}"
