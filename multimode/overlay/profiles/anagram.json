        "B": {
          "label": "SC+",
          "color": "TURQUOISE",
          "short": [
            {
              "cc": 108
            },
            {
              "set": "msg",
              "to": "'Scene +'"
            }
          ],
          "long": [
            {
              "cc": 103
            },
            {
              "set": "msg",
              "to": "'Bank +'"
            }
          ],
          "desc": {
            "short": "다음 씬 (CC108)",
            "long": "다음 뱅크 (CC103)"
          }
