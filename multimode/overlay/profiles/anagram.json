          ],
          "long": [
            {
              "cc": 104
            },
            {
              "set": "msg",
              "to": "'Bank -'"
            }
          ],
          "desc": {
            "short": "이전 씬 (CC109)",
            "long": "이전 뱅크 (CC104)"
